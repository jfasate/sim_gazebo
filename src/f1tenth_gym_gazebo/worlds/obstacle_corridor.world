            <name>Gazebo/Grey</name>
          </script>
          <ambient>1 1 1 1</ambient>
        </material>
      </visual>
      <pose>2.0000 -0.9000 0 0 -0 0.00000</pose>
    </link>
    <link name='Obstacle_7'>
      <collision name='Obstacle_7_Collision'>
        <geometry><box><size>0.8000 0.8000 0.6000</size></box></geometry>
        <pose>0 0 0.3000 0 -0 0</pose>
      </collision>
      <visual name='Obstacle_7_Visual'>
        <pose>0 0 0.3000 0 -0 0</pose>
        <geometry><box><size>0.8000 0.8000 0.6000</size></box></geometry>
        <material>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grey</name>
          </script>
          <ambient>1 1 1 1</ambient>
        </material>
      </visual>
      <pose>6.0000 0.9000 0 0 -0 0.00000</pose>
    </link>
    <static>1</static>
  </model>
  </world>
</sdf>
