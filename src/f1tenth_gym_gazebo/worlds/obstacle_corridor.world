            <name>Gazebo/Grey</name>
          </script>
          <ambient>1 1 1 1</ambient>
        </material>
      </visual>
      <pose>-2.0000 0.9000 0 0 -0 0.00000</pose>
    </link>
    <link name='Obstacle_6'>
      <collision name='Obstacle_6_Collision'>
        <geometry><box><size>0.8000 0.8000 0.6000</size></box></geometry>
        <pose>0 0 0.3000 0 -0 0</pose>
      </collision>
      <visual name='Obstacle_6_Visual'>
        <pose>0 0 0.3000 0 -0 0</pose>
