          <ambient>1 1 1 1</ambient>
        </material>
      </visual>
      <pose>-12.5000 0.0000 0 0 -0 1.57080</pose>
    </link>
    <link name='Wall_3'>
      <collision name='Wall_3_Collision'>
        <geometry><box><size>3.1500 0.1500 0.6000</size></box></geometry>
        <pose>0 0 0.3000 0 -0 0</pose>
      </collision>
      <visual name='Wall_3_Visual'>
        <pose>0 0 0.3000 0 -0 0</pose>
        <geometry><box><size>3.1500 0.1500 0.6000</size></box></geometry>
        <material>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grey</name>
          </script>
          <ambient>1 1 1 1</ambient>
        </material>
      </visual>
      <pose>12.5000 0.0000 0 0 -0 1.57080</pose>
    </link>
    <link name='Obstacle_4'>
      <collision name='Obstacle_4_Collision'>
        <geometry><box><size>0.8000 0.8000 0.6000</size></box></geometry>
        <pose>0 0 0.3000 0 -0 0</pose>
      </collision>
      <visual name='Obstacle_4_Visual'>
        <pose>0 0 0.3000 0 -0 0</pose>
        <geometry><box><size>0.8000 0.8000 0.6000</size></box></geometry>
        <material>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grey</name>
          </script>
          <ambient>1 1 1 1</ambient>
        </material>
      </visual>
      <pose>-6.0000 -0.9000 0 0 -0 0.00000</pose>
    </link>
    <link name='Obstacle_5'>
      <collision name='Obstacle_5_Collision'>
