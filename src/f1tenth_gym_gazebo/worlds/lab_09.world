<?xml version="1.0" ?>
<sdf version='1.7'>
  <world name='default'>
    <!-- gazebo_ros_state: provides /set_entity_state + /get_entity_state and
         publishes /model_states, /link_states. This is a WorldPlugin and MUST
         be declared here — loading it via `gzserver -s` fails with "incorrect
         plugin type", which silently disables the co-sim (car frozen in
         Gazebo). Keep it in the world, not on the gzserver command line. -->
    <plugin name='gazebo_ros_state' filename='libgazebo_ros_state.so'>
      <ros>
        <namespace>/</namespace>
      </ros>
      <update_rate>1000.0</update_rate>
    </plugin>

    <light name='sun' type='directional'>
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 -0 0</pose>
      <diffuse>0.15 0.15 0.14 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>0.05 0.02 -1.0</direction>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>
    <model name='ground_plane'>
      <static>1</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
              <torsional>
                <ode/>
              </torsional>
            </friction>
            <contact>
              <ode/>
            </contact>
            <bounce/>
          </surface>
          <max_contacts>10</max_contacts>
        </collision>
        <self_collide>0</self_collide>
        <enable_wind>0</enable_wind>
        <kinematic>0</kinematic>
      </link>
    </model>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type='adiabatic'/>
    <physics type='ode'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <scene>
      <ambient>0.69 0.69 0.67 1</ambient>
      <background>0.80 0.77 0.68 1</background>
      <shadows>1</shadows>
    </scene>
    <audio>
      <device>default</device>
    </audio>
    <wind/>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>0</latitude_deg>
      <longitude_deg>0</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>
    <model name='lab_09'>
    <static>1</static>
    <pose>0 0 0.001 0 0 0</pose>
    <link name='floor'>
      <visual name='floor_visual'>
        <cast_shadows>0</cast_shadows>
        <geometry><mesh><uri>model://lab_09/meshes/floor.obj</uri></mesh></geometry>
      </visual>
    </link>
    <link name='ducts'>
      <visual name='ducts_visual'>
        <geometry><mesh><uri>model://lab_09/meshes/ducts.obj</uri></mesh></geometry>
      </visual>
      <collision name='ducts_collision'>
        <geometry><mesh><uri>model://lab_09/meshes/ducts.obj</uri></mesh></geometry>
      </collision>
    </link>
